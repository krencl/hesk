# Výchozí hodnoty pro produkci (https://hesk.krencl.cz/); necommitují se tu žádná tajemství.
# Tajemství (APP_SECRET, DB_*, OAUTH_GOOGLE_*, BGG_API_TOKEN) patří do .env.prod.local nebo do skutečných
# proměnných prostředí. APP_ENV=prod se musí nastavit v prostředí (php-fpm/nginx) nebo přes `composer dump-env prod`.

# Absolutní URL pro odkazy generované mimo HTTP kontext (příkazy)
DEFAULT_URI=https://hesk.krencl.cz

# SPA i API jsou na stejném origin, CORS stačí zúžit na vlastní doménu
CORS_ALLOW_ORIGIN='^https://hesk\.krencl\.cz$'

# Po přihlášení zpět na stejný origin
FRONTEND_URL=/
