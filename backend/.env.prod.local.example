# Šablona pro backend/.env.prod.local na serveru (soubor se necommituje; chmod 600).
# Vygenerovat tajný klíč: php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
APP_SECRET=
DB_HOSTNAME=127.0.0.1
DB_PORT=3306
DB_DATABASE=hesk
DB_USERNAME=hesk
DB_PASSWORD=
DB_SERVER_VERSION=mariadb-11.0.2
OAUTH_GOOGLE_ID=
OAUTH_GOOGLE_SECRET=
BGG_API_TOKEN=
# Za reverzní proxy na jiném stroji nahraďte její IP/CIDR (nginx musí posílat X-Forwarded-Proto/Host/Port)
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
